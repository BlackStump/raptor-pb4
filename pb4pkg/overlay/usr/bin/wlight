#!/bin/sh
# wlight -- white light on motion at night, for Raptor on HiSilicon and Fullhan (no IVS there).
#
# Asks for motion about once a second and at night switches the white LEDs on while
# there is motion: IR-cut filter in, ISP in colour, day/night switching frozen. Back to
# normal night (IR, monochrome, ric auto) after HOLD seconds without motion.
#
# Where the motion comes from (SOURCE):
#   rvd    rvd's own detection ([motion] enabled): it scales out exposure and light
#          changes across the picture before comparing, so another camera's lamps or
#          the AE settling do not read as motion; the same detection gives the ONVIF
#          motion events. No frame copies here.
#   ydiff  grab the sub-stream (raptorctl rvd save raw) and compare raw
#          brightness of successive frames with ydiff (the original way).
#   auto   rvd when its detection is running, otherwise ydiff (the default).
#
# Safeguards against the "light never goes off" loop:
#   - a frame change across most of the picture is treated as a lighting change, not motion,
#     and motion is ignored for SETTLE_OFF seconds after it while exposure settles: another
#     camera's lamps, the garage light or a day/night switch must not look like motion
#   - motion is ignored for SETTLE seconds after the light goes on (SETTLE_OFF after it goes off)
#   - switching on needs motion in TRIGGER frames in a row
#   - day/night switching is frozen while the light is on, and night is judged before it
#   - the light goes off after MAXON seconds regardless; it re-arms only after a quiet period
#
# usage: wlight [-v]        (-v also prints every decision to the terminal)
# Settings below can be overridden in /etc/wlight.conf (same NAME=value lines).

LEVEL=50        # white brightness, 0-100
HOLD=40         # seconds the light stays on after the last motion
MAXON=180       # hard limit for one switch-on
SETTLE=4        # seconds to ignore motion after switching on (exposure settles)
SETTLE_OFF=10   # the same after switching off: IR-cut, monochrome and IR exposure take longer
TRIGGER=2       # consecutive motion frames needed to switch on (a one-frame blip is not motion)
QUIET=10        # after MAXON, motion must stop this long before the light can re-arm
MINCELLS=15     # grid cells (of 576) that must change to count as motion
MAXCELLS=430    # more than this many changed cells = lighting change, ignored
THRESH=10       # brightness change (0-255) for a grid cell to count as changed
POLL=1          # seconds between frames
CHN=1           # rvd channel to sample (1 = the sub-stream)
RVD_LOG=warn    # rvd logs every frame grab at info; keep it at this level ("" leaves it alone)
IR_VIA_RIC=0    # 1 = ric owns the IR LEDs (PB4: pwm_irled), switch them off while white is on
SOURCE=auto     # rvd, ydiff or auto (see above)

[ -f /etc/wlight.conf ] && . /etc/wlight.conf

VERBOSE=0
[ "$1" = "-v" ] && VERBOSE=1
DIR=/tmp/wlight
PREV=$DIR/prev.nv21
CUR=$DIR/cur.nv21
mkdir -p "$DIR"

log() {
	logger -t wlight "$*"
	[ "$VERBOSE" = 1 ] && echo "$(date +%T) $*"
}

is_night() {
	raptorctl ric status 2>/dev/null | grep -q '"state":"night"'
}

light_on() {
	raptorctl ric mode night >/dev/null      # freeze day/night switching
	# PB4: ric drives the IR LEDs itself (pwm_irled); with the filter in they
	# only add heat, so switch them off while the white light is on.
	[ "$IR_VIA_RIC" = 1 ] && raptorctl ric ir850 off >/dev/null
	raptorctl ric ircut day >/dev/null       # filter in: true colour under white light
	raptorctl ric isp-mode day >/dev/null    # colour picture
	lamp white "$LEVEL" >/dev/null
	log "motion at night: white light on ($LEVEL%)"
}

light_off() {
	lamp white 0 >/dev/null
	raptorctl ric isp-mode night >/dev/null
	raptorctl ric ircut night >/dev/null
	[ "$IR_VIA_RIC" = 1 ] && raptorctl ric ir850 on >/dev/null
	raptorctl ric mode auto >/dev/null       # hand day/night back to ric
	log "white light off ($1)"
}

state=idle      # idle | on | lockout
on_since=0; last_motion=0; settle_until=0; quiet_since=0; streak=0

cleanup() {
	[ "$state" = on ] && light_off "wlight stopping"
	rm -rf "$DIR"
	exit 0
}
trap cleanup INT TERM

quiet_rvd() {
	[ -n "$RVD_LOG" ] && raptorctl rvd set-log-level "$RVD_LOG" >/dev/null 2>&1
}
quiet_rvd; last_quiet=$(date +%s)

# rvd's detection is running when ivs-status says active
rvd_active() {
	raptorctl rvd ivs-status 2>/dev/null | grep -Eq '"active"[[:space:]]*:[[:space:]]*true'
}
case "$SOURCE" in
rvd | ydiff) ;;
*) if rvd_active; then SOURCE=rvd; else SOURCE=ydiff; fi ;;
esac

if [ "$SOURCE" = rvd ]; then
	log "started (level $LEVEL%, hold ${HOLD}s, max ${MAXON}s, motion from rvd)"
else
	log "started (level $LEVEL%, hold ${HOLD}s, max ${MAXON}s, cells $MINCELLS..$MAXCELLS)"
fi
while :; do
	sleep "$POLL"
	now=$(date +%s)
	motion=0

	if [ "$SOURCE" = rvd ]; then
		# rvd rests by itself after a whole-scene change (its own lamps
		# included) and holds motion 2 s after the last movement
		r=$(raptorctl rvd ivs-status 2>/dev/null) || continue
		if [ "$now" -ge "$settle_until" ] &&
			echo "$r" | grep -Eq '"motion"[[:space:]]*:[[:space:]]*true'; then
			motion=1
		fi
		[ "$VERBOSE" = 1 ] && { [ "$state" != idle ] || [ "$motion" = 1 ]; } &&
			echo "$(date +%T)   [$state] motion=$motion"
	else
		r=$(raptorctl rvd save raw "$CUR" "$CHN" 2>/dev/null) || continue
		# the frame's size, from rvd's answer (640x360 on the PB4, 640x480 on
		# the XM550)
		fw=$(echo "$r" | sed -n 's/.*"width":\([0-9]*\).*/\1/p')
		fh=$(echo "$r" | sed -n 's/.*"height":\([0-9]*\).*/\1/p')
		# rvd forgets the level when it restarts (config apply), so say it again now and then
		if [ $((now - last_quiet)) -ge 300 ]; then quiet_rvd; last_quiet=$now; fi
		if [ ! -f "$PREV" ]; then
			mv "$CUR" "$PREV"
			continue
		fi
		set -- $(ydiff "$PREV" "$CUR" "${fw:-640}" "${fh:-360}" 20 "$THRESH" 2>/dev/null | tr '=' ' ')
		mv "$CUR" "$PREV"
		changed=${2:-0}; dmean=${6:-0}
		[ "$VERBOSE" = 1 ] && { [ "$state" != idle ] || [ "$changed" -gt 0 ]; } && echo "$(date +%T)   [$state] changed=$changed dmean=$dmean"

		if [ "$now" -ge "$settle_until" ] && [ "$changed" -ge "$MINCELLS" ] &&
			[ "$changed" -le "$MAXCELLS" ]; then
			motion=1
		fi
		# A lighting change (most of the picture at once): never motion, and the
		# exposure settling after it changes a few hundred cells for some seconds,
		# which would pass as motion -- with several cameras in one room, each
		# one's lamps would set off the others. Rest instead.
		if [ "$changed" -gt "$MAXCELLS" ]; then
			[ "$state" = idle ] && streak=0
			settle_until=$((now + SETTLE_OFF))
			[ "$VERBOSE" = 1 ] && log "lighting change ignored ($changed cells), resting ${SETTLE_OFF}s"
		fi
	fi

	case "$state" in
	idle)
		if [ "$motion" = 1 ]; then streak=$((streak + 1)); else streak=0; fi
		if [ "$streak" -ge "$TRIGGER" ] && is_night; then
			streak=0
			light_on
			state=on; on_since=$now; last_motion=$now
			settle_until=$((now + SETTLE))
		fi
		;;
	on)
		[ "$motion" = 1 ] && last_motion=$now
		if [ $((now - on_since)) -ge "$MAXON" ]; then
			light_off "on for ${MAXON}s, the limit"
			state=lockout; quiet_since=$now
			settle_until=$((now + SETTLE_OFF))
		elif [ $((now - last_motion)) -ge "$HOLD" ]; then
			light_off "no motion for ${HOLD}s"
			state=idle; streak=0
			settle_until=$((now + SETTLE_OFF))
		fi
		;;
	lockout)
		[ "$motion" = 1 ] && quiet_since=$now
		if [ $((now - quiet_since)) -ge "$QUIET" ]; then
			state=idle
			log "re-armed after ${QUIET}s without motion"
		fi
		;;
	esac
done
