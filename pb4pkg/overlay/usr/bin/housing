#!/bin/sh
# housing -- set this PB4 up for the housing it is in.
#
#   housing pb4       PB4 housing: IR + white LED board on the module's
#                     R/W pins (white PWM 2, IR PWM 3). ric lights the IR
#                     at night, wlight the white on motion.
#   housing ceiling   ceiling housing: an IR LED board with its own light
#                     sensor that switches its IR itself. Nothing on the
#                     module's lamp pins (its sensor wire stays off the
#                     PB4: it gives 0/5 V and the PB4's CDS pin is neither
#                     an ADC channel nor a GPIO input on this board). ric
#                     only switches the IR-cut, by gain. No white light.
#   housing           which one this camera is set for
#
#   housing --boot X  as above, without restarting anything (S95pb4, first
#                     boot, from the U-Boot env's housing= line)
#
# The image is built for the PB4 housing. Edits /etc/raptor.conf's
# [ircut], writes or removes /etc/wlight.conf, records the choice in
# /etc/housing and restarts Raptor (and wlight).

RC=/etc/raptor.conf
DEF=/usr/share/raptor

restart=1
[ "$1" = --boot ] && { restart=0; shift; }

# ircut KEY VALUE: set KEY in [ircut], adding it if missing; VALUE "" deletes
ircut() {
	awk -v k="$1" -v v="$2" '
		function out() { if (!done && v != "") print k " = " v; done = 1 }
		/^\[/ { if (in_s) out(); in_s = ($0 == "[ircut]") }
		in_s && $0 ~ "^" k "[ \t]*=" { if (v != "") print k " = " v; done = 1; next }
		{ print }
		END { if (in_s) out() }' "$RC" > "$RC.new" && mv "$RC.new" "$RC"
}

current() {
	cat /etc/housing 2>/dev/null || echo pb4
}

case "$1" in
pb4)
	ircut pwm_irled 3
	ircut pwm_irled_mask 12
	ircut pwm_irled_duty 8500
	ircut pwm_irled_period 10000
	[ -f /etc/wlight.conf ] || cp "$DEF/wlight.conf.default" /etc/wlight.conf
	lamp off
	echo pb4 > /etc/housing
	;;
ceiling)
	ircut pwm_irled ""
	ircut pwm_irled_mask ""
	ircut pwm_irled_duty ""
	ircut pwm_irled_period ""
	[ $restart = 1 ] && /etc/init.d/S97wlight stop >/dev/null 2>&1
	rm -f /etc/wlight.conf
	lamp off
	echo ceiling > /etc/housing
	;;
"")
	echo "set for: $(current)"
	grep -E '^(trigger|pwm_irled|night_threshold|day_threshold|hysteresis_sec) ' "$RC"
	[ -f /etc/wlight.conf ] && echo "wlight: on" || echo "wlight: off"
	exit 0
	;;
*) echo "usage: housing [pb4|ceiling]"; exit 1 ;;
esac

if [ $restart = 1 ]; then
	/etc/init.d/S96raptor restart
	[ -f /etc/wlight.conf ] && /etc/init.d/S97wlight restart
fi
echo "set for: $(current)"
